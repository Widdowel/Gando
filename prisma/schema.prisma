generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  nom           String
  prenom        String
  email         String   @unique
  password      String
  telephone     String?
  pays          String   // "BJ" | "TG" | "BF" | "CI" | "AE"
  statutKyc     String   @default("pending") // pending | verified | rejected
  type          String   // "cotisant" | "contributeur" | "admin"
  cotisations   Cotisation[]
  achats        AchatGadget[]
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Pays {
  code          String   @id // "BJ" | "TG" | "BF" | "CI" | "AE"
  nom           String
  devise        String   // "FCFA" | "AED"
  tarifNuitMin  Int      // en unité de devise locale
  tarifNuitMax  Int
  residences    Residence[]
}

model ResidenceType {
  id              String   @id @default(cuid())
  nom             String
  standing        String   // "modeste" | "royal"
  nbStudios       Int      // 4 à 10
  superficie      Int      // m² par studio
  budgetCible     BigInt   // en FCFA
  descriptionCourte String
  descriptionComplete String
  equipements     String[] // liste des équipements
  matterportUrl   String?  // URL visite virtuelle Matterport
  photos          String[] // URLs Cloudflare R2
  planUrl         String?  // URL du plan architectural
  residences      Residence[]
  gadgets         Gadget[]
}

model Residence {
  id              String   @id @default(cuid())
  nom             String
  paysCode        String
  pays            Pays     @relation(fields: [paysCode], references: [code])
  typeId          String
  type            ResidenceType @relation(fields: [typeId], references: [id])
  statut          String   @default("planifiee")
  // planifiee | en_construction | en_exploitation | cloturee
  cagnottes       Cagnotte[]
  gadgets         Gadget[]
  revenus         RevenuLocatif[]
  etapesChantier  ChantierEtape[]
}

model Cagnotte {
  id                  String   @id @default(cuid())
  residenceId         String
  residence           Residence @relation(fields: [residenceId], references: [id])
  budgetTotal         BigInt
  prixParcelle        BigInt
  nbParticipantsRequis Int
  cotisationMensuelle  Int      // en FCFA
  statut              String   @default("ouverte")
  // ouverte | complete | en_construction | en_exploitation | remboursement_foncier | cloturee
  dateOuverture       DateTime @default(now())
  cotisants           Cotisation[]
  attributions        Attribution[]
}

model Cotisation {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  cagnotteId    String
  cagnotte      Cagnotte @relation(fields: [cagnotteId], references: [id])
  ordreInscription Int   // position dans la file d'attente
  montantPaye   BigInt   @default(0)
  statut        String   @default("actif") // actif | suspendu | defaillant | complete
  paiements     PaiementCotisation[]
  redistribution RedistributionMutuelle[]
  attribution   Attribution?
  createdAt     DateTime @default(now())
}

model PaiementCotisation {
  id            String   @id @default(cuid())
  cotisationId  String
  cotisation    Cotisation @relation(fields: [cotisationId], references: [id])
  montant       Int
  datePaiement  DateTime @default(now())
  methodePaiement String  // "mobile_money" | "virement" | "carte"
  reference     String?
}

model ChantierEtape {
  id            String   @id @default(cuid())
  residenceId   String
  residence     Residence @relation(fields: [residenceId], references: [id])
  titre         String
  description   String
  statut        String   // "planifiee" | "en_cours" | "terminee"
  dateDebut     DateTime?
  dateFin       DateTime?
  photos        String[]
  ordre         Int
}

model RevenuLocatif {
  id            String   @id @default(cuid())
  residenceId   String
  residence     Residence @relation(fields: [residenceId], references: [id])
  mois          Int
  annee         Int
  revenutBrut   Int
  fraisGestion  Int      // 20% du brut
  revenuNet     Int      // brut - frais
  tauxOccupation Float
  redistribMutuelle RedistributionMutuelle[]
  versementsCrowd   VersementCrowdfunding[]
  createdAt     DateTime @default(now())
}

model RedistributionMutuelle {
  id            String   @id @default(cuid())
  cotisationId  String
  cotisation    Cotisation @relation(fields: [cotisationId], references: [id])
  revenuId      String
  revenu        RevenuLocatif @relation(fields: [revenuId], references: [id])
  montant       Int
  dateVersement DateTime @default(now())
}

model Attribution {
  id            String   @id @default(cuid())
  cagnotteId    String
  cagnotte      Cagnotte @relation(fields: [cagnotteId], references: [id])
  cotisationId  String   @unique
  cotisation    Cotisation @relation(fields: [cotisationId], references: [id])
  dateAttribution DateTime @default(now())
  statut        String   @default("en_attente")
  // en_attente | parcelle_remboursee | titre_delivre
}

model Gadget {
  id              String   @id @default(cuid())
  nom             String
  description     String
  prix            Int      // en FCFA
  recompenseCible Int      // montant fixe total à reverser
  stockTotal      Int
  stockVendu      Int      @default(0)
  photo           String?
  residenceId     String
  residence       Residence @relation(fields: [residenceId], references: [id])
  typeId          String
  type            ResidenceType @relation(fields: [typeId], references: [id])
  achats          AchatGadget[]
}

model AchatGadget {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  gadgetId        String
  gadget          Gadget   @relation(fields: [gadgetId], references: [id])
  montantPaye     Int
  recompenseCible Int      // copie au moment de l'achat
  cumulRecu       Int      @default(0)
  statut          String   @default("actif") // actif | complete | livre
  statutLivraison String   @default("en_preparation")
  // en_preparation | expedie | livre
  adresseLivraison String?
  versements      VersementCrowdfunding[]
  createdAt       DateTime @default(now())
}

model VersementCrowdfunding {
  id            String   @id @default(cuid())
  achatId       String
  achat         AchatGadget @relation(fields: [achatId], references: [id])
  revenuId      String
  revenu        RevenuLocatif @relation(fields: [revenuId], references: [id])
  montant       Int
  dateVersement DateTime @default(now())
}
